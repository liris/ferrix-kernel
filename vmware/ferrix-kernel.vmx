.encoding = "UTF-8"
config.version = "8"
virtualHW.version = "22"
displayName = "ferrix-kernel"
guestOS = "arm-other-64"
firmware = "efi"
numvcpus = "1"
memsize = "512"
pciBridge4.present = "TRUE"
pciBridge4.virtualDev = "pcieRootPort"
pciBridge4.functions = "8"
sata0.present = "TRUE"
sata0:1.present = "TRUE"
sata0:1.deviceType = "cdrom-image"
sata0:1.fileName = "../ferrix-kernel.iso"
usb.present = "TRUE"
usb_xhci.present = "TRUE"
floppy0.present = "FALSE"
# Answer any VMware dialog with its default so boots never block.
msg.autoAnswer = "TRUE"
